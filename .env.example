# NOWPayments API Configuration
# Get your API key from https://account.nowpayments.io/
NOWPAYMENTS_API_KEY=your_api_key_here

# IPN (Instant Payment Notification) Secret for webhook verification
# Set this in your NOWPayments account settings
NOWPAYMENTS_IPN_SECRET=your_ipn_secret_here

# Next.js Environment
# IMPORTANT: Must be updated to your production Vercel URL before go-live
# e.g. NEXT_PUBLIC_SITE_URL=https://lumopep.com
# Used to build NOWPayments callback URLs — wrong value breaks post-payment redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration
# Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Test Order Endpoint (/api/test-order)
# Set TEST_MODE=true for local dev to skip secret header check.
# NEVER set TEST_MODE=true on Vercel production.
# TEST_MODE=true
#
# Set a strong random string as TEST_SECRET to protect the endpoint in staging.
# Pass as x-test-secret header: curl -X POST /api/test-order -H "x-test-secret: <value>"
TEST_SECRET=replace-with-a-strong-random-secret

# Rapid Fulfillment CRM
# Credentials from your Rapid Fulfillment account
RAPID_API_USERNAME=your_rapid_username
RAPID_API_PASSWORD=your_rapid_password
# Prefix prepended to every order ID sent to Rapid (e.g. "1" → "1-<order_id>")
RAPID_ORDER_PREFIX=1
# Set to "true" to route orders to the sandbox endpoint during testing
# RAPID_USE_TEST=true

# Contact Form (optional - for email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_password
# CONTACT_EMAIL=support@lumopep.com
