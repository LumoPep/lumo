# NOWPayments API Configuration
# Get your API key from https://account.nowpayments.io/
NOWPAYMENTS_API_KEY=your_api_key_here

# IPN (Instant Payment Notification) Secret for webhook verification
# Set this in your NOWPayments account settings
NOWPAYMENTS_IPN_SECRET=your_ipn_secret_here

# Next.js Environment
# IMPORTANT: Must be updated to your production Vercel URL before go-live
# e.g. NEXT_PUBLIC_SITE_URL=https://lumopep.com
# Used to build NOWPayments callback URLs — wrong value breaks post-payment redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact Form (optional - for email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_password
# CONTACT_EMAIL=support@lumopep.com
